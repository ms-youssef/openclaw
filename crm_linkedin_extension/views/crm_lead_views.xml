<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_linkedin" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.linkedin</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Target the website field in the lead partner info group -->
            <xpath expr="//group[@name='lead_partner']//field[@name='website']" position="after">
                <field name="linkedin_profile" widget="url" placeholder="e.g. https://www.linkedin.com/in/john-doe"/>
                <field name="company_linkedin" widget="url" placeholder="e.g. https://www.linkedin.com/company/microsoft"/>
            </xpath>
            <!-- Target the website field in the 'lead' page (Contact Information) -->
            <xpath expr="//page[@name='lead']//field[@name='website']" position="after">
                <field name="linkedin_profile" widget="url" placeholder="e.g. https://www.linkedin.com/in/john-doe"/>
                <field name="company_linkedin" widget="url" placeholder="e.g. https://www.linkedin.com/company/microsoft"/>
            </xpath>
        </field>
    </record>
</odoo>
