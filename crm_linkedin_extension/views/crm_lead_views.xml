<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_linkedin" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.linkedin</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Target the website field in the main group (usually for Opportunities) -->
            <xpath expr="//group[@name='opportunity_info']//field[@name='website']" position="after">
                <field name="linkedin_profile" widget="url" placeholder="e.g. https://www.linkedin.com/in/john-doe"/>
                <field name="company_linkedin" widget="url" placeholder="e.g. https://www.linkedin.com/company/microsoft"/>
            </xpath>
            <!-- Target the website field in the Contact Information group (usually for Leads) -->
            <xpath expr="//group[@string='Contact Information']//field[@name='website']" position="after">
                <field name="linkedin_profile" widget="url" placeholder="e.g. https://www.linkedin.com/in/john-doe"/>
                <field name="company_linkedin" widget="url" placeholder="e.g. https://www.linkedin.com/company/microsoft"/>
            </xpath>
        </field>
    </record>
</odoo>
