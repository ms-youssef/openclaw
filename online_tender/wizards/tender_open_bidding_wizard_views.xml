<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tender_open_bidding_wizard_form" model="ir.ui.view">
        <field name="name">tender.open.bidding.wizard.form</field>
        <field name="model">tender.open.bidding.wizard</field>
        <field name="arch" type="xml">
            <form string="Open Live Bidding">
                <group>
                    <field name="requisition_id" readonly="1"/>
                    <field name="duration_minutes"/>
                </group>
                <footer>
                    <button name="action_open_bidding" string="Open Bidding" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
