<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tender_tag_list" model="ir.ui.view">
        <field name="name">tender.tag.list</field>
        <field name="model">tender.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tender_tag_form" model="ir.ui.view">
        <field name="name">tender.tag.form</field>
        <field name="model">tender.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tender_tag" model="ir.actions.act_window">
        <field name="name">Tender Tags</field>
        <field name="res_model">tender.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
