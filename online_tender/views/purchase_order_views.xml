<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_online_tender" model="ir.ui.view">
        <field name="name">purchase.order.form.online.tender</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_online_tender_approve_technical" string="Approve Technical" type="object" class="btn-primary" invisible="not online_tender_requisition_id or online_tender_technical_state == 'approved' or state not in ('draft', 'sent')"/>
                <button name="action_online_tender_reject_technical" string="Reject Technical" type="object" class="btn-secondary" invisible="not online_tender_requisition_id or online_tender_technical_state == 'rejected' or state not in ('draft', 'sent')"/>
                <button name="action_online_tender_reset_technical" string="Reset Technical Review" type="object" invisible="not online_tender_requisition_id or online_tender_technical_state == 'pending' or state not in ('draft', 'sent')"/>
                <field name="online_tender_technical_state" widget="statusbar" statusbar_visible="pending,approved,rejected" readonly="1" invisible="not online_tender_requisition_id"/>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="Online Tender" invisible="not online_tender_requisition_id">
                    <group>
                        <field name="online_tender_requisition_id" readonly="1"/>
                        <field name="online_tender_invitation_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="online_tender_technical_state" readonly="1"/>
                        <field name="online_tender_tag_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='price_unit']" position="after">
                <field name="tender_delivery_days" optional="show"/>
                <field name="tender_technical_approved" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
