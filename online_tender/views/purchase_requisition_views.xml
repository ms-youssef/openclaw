<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_requisition_form_online_tender" model="ir.ui.view">
        <field name="name">purchase.requisition.form.online.tender</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_invitations" string="Send Invitations" type="object" class="btn-primary" invisible="not is_online_tender or online_state not in ('draft', 'invited', 'quote_entry')"/>
                <button name="action_open_bidding" string="Open Live Bidding" type="object" class="btn-primary" invisible="not is_online_tender or online_state == 'bidding_open' or online_state == 'awarded'"/>
                <button name="action_close_bidding" string="Close Bidding" type="object" invisible="not is_online_tender or online_state != 'bidding_open'"/>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="Online Tender">
                    <group>
                        <field name="is_online_tender"/>
                        <field name="online_state" readonly="1" invisible="not is_online_tender"/>
                        <field name="vendor_partner_ids" widget="many2many_tags" invisible="not is_online_tender"/>
                    </group>
                    <group invisible="not is_online_tender">
                        <field name="bidding_duration_minutes"/>
                        <field name="bidding_start_at" readonly="1"/>
                        <field name="bidding_end_at" readonly="1"/>
                        <field name="winning_invitation_id" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Online Tender" invisible="not is_online_tender">
                    <field name="invitation_ids">
                        <list>
                            <field name="state"/>
                            <field name="partner_id"/>
                            <field name="total_amount"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_online_tender_requisition" model="ir.actions.act_window">
        <field name="name">Online Tenders</field>
        <field name="res_model">purchase.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_online_tender', '=', True)]</field>
        <field name="context">{'default_is_online_tender': True}</field>
    </record>
</odoo>
