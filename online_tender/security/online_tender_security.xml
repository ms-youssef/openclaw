<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_online_tender" model="ir.module.category">
        <field name="name">Online Tender</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_online_tender_user" model="res.groups.privilege">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_online_tender"/>
    </record>

    <record id="privilege_online_tender_manager" model="res.groups.privilege">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_online_tender"/>
    </record>

    <record id="group_tender_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_online_tender_user"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_tender_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_online_tender_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_tender_user')), (4, ref('purchase.group_purchase_manager'))]"/>
    </record>

    <record id="tender_invitation_portal_rule" model="ir.rule">
        <field name="name">Tender Invitation Portal Access</field>
        <field name="model_id" ref="model_tender_invitation"/>
        <field name="domain_force">[('partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="tender_bid_portal_rule" model="ir.rule">
        <field name="name">Tender Bid Portal Access</field>
        <field name="model_id" ref="model_tender_bid"/>
        <field name="domain_force">[('invitation_id.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="tender_bid_line_portal_rule" model="ir.rule">
        <field name="name">Tender Bid Line Portal Access</field>
        <field name="model_id" ref="model_tender_bid_line"/>
        <field name="domain_force">[('invitation_id.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
