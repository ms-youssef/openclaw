<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_governance" model="ir.module.category">
        <field name="name">Project Governance</field>
        <field name="sequence">10</field>
    </record>

    <!-- Odoo 19 uses res.groups.privilege to link groups to categories -->
    <record id="privilege_project_governance_approver" model="res.groups.privilege">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_project_governance"/>
    </record>

    <record id="group_project_governance_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_project_governance_approver"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>
</odoo>
