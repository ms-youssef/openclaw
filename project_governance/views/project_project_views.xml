<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_governance" model="ir.ui.view">
        <field name="name">project.project.view.form.inherit.governance</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_request_approval" string="Request Stage Approval" type="object"
                        class="btn-primary" invisible="not is_governance_enabled or governance_state != 'draft'"/>
                <button name="action_approve_governance" string="Approve Stage Gate" type="object"
                        class="btn-success" invisible="not is_governance_enabled or governance_state != 'ready'"
                        groups="project_governance.group_project_governance_approver"/>
                <field name="governance_state" widget="statusbar" statusbar_visible="draft,ready,approved"
                       invisible="not is_governance_enabled"/>
            </header>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_governance_enabled"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Financial Control" name="governance_financial_control" invisible="not is_governance_enabled">
                    <group>
                        <group string="Effort Baseline">
                            <field name="allocated_hours" widget="float_time" string="Budgeted Hours"/>
                            <field name="effective_hours" widget="float_time" string="Consumed Hours"/>
                            <field name="remaining_hours" widget="float_time"/>
                        </group>
                        <group string="Utilization Analysis">
                            <field name="utilization_rate" widget="progressbar"/>
                            <field name="budget_status" widget="badge" 
                                   decoration-success="budget_status == 'on_track'"
                                   decoration-warning="budget_status == 'at_risk'"
                                   decoration-danger="budget_status == 'over_budget'"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
